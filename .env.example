# ArcTradeProof AI — Environment Variable Reference
#
# Copy this file to .env for local development.
# NEVER commit .env with real values.
# In production (Render), set these in the Render dashboard → Environment tab.
#
# ── Required for AI document extraction and report generation ─────────────────
OPENAI_API_KEY=sk-...your-key-here...

# ── Required in production when SPA and API are on different origins ──────────
# Set to your exact frontend origin, e.g. https://arctradeproof.onrender.com
# Omit when SPA and API share the same origin (recommended Render setup).
# ALLOWED_ORIGIN=https://your-app.onrender.com

# ── Server port (Render sets PORT automatically; 3001 is the local default) ───
# PORT=3001

# ── Node environment ──────────────────────────────────────────────────────────
# Render sets this automatically in its environment.
# NODE_ENV=production
