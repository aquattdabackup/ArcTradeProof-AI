# Server-side only. Copy locally to .env; never commit real values.
OPENAI_API_KEY=
# Production same-origin URL, exact HTTPS origin with no trailing slash.
# Vercel: set explicitly for the stable production/custom domain.
# Preview fallback is https://VERCEL_URL (exact deployment only; no wildcard aliases).
# Standalone historical Render fallback: RENDER_EXTERNAL_URL.
# No configuration => Origin requests denied.
# PUBLIC_ORIGIN=https://your-project.vercel.app
# Vercel Node adapter: keep helpers off so Express owns parsing and errors.
# NODEJS_HELPERS=0
# Optional additional exact HTTPS frontend origin; never *.
# ALLOWED_ORIGIN=https://your-frontend.example
# PORT=3001
# NODE_ENV=production
# Default 0 (direct connection). Set 1 only behind one trusted, verified proxy hop.
TRUST_PROXY_HOPS=0
# Total AI attempts across all visitors; disabled by default, maximum 300.
AI_MAX_CALLS=0
# Do NOT set AI_BUDGET_FILE on Vercel: file budgets are disabled there, including /tmp.
# Standalone servers only: absolute path on retained storage outside dist; one process.
# This example does not provision or verify persistent storage.
# AI_BUDGET_FILE=/var/data/arctradeproof/ai-calls.json
# Development only; captures console/network/wallet data. Use synthetic data.
# VITE_STUDIO_DEBUG=false
