# Server-side only. Copy locally to .env; never commit real values.
OPENAI_API_KEY=
# Production same-origin URL, exact HTTPS origin with no trailing slash.
# Defaults to RENDER_EXTERNAL_URL on Render. No configuration => Origin requests denied.
# PUBLIC_ORIGIN=https://your-app.onrender.com
# Optional additional exact HTTPS frontend origin; never *.
# ALLOWED_ORIGIN=https://your-frontend.example
# PORT=3001
# NODE_ENV=production
# Default 0 (direct connection). Set 1 only behind one trusted, verified proxy hop.
TRUST_PROXY_HOPS=0
# Total AI attempts across all visitors; disabled by default, maximum 300.
AI_MAX_CALLS=0
# Absolute path on persistent storage, outside dist. One process/instance only.
# This example does not provision a disk. Render storage has not been verified configured.
# AI_BUDGET_FILE=/var/data/arctradeproof/ai-calls.json
# Development only; captures console/network/wallet data. Use synthetic data.
# VITE_STUDIO_DEBUG=false
